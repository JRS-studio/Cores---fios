# Copie para .env e preencha com os dados do seu projeto Supabase (Project Settings › API).
# Sem estas variáveis o app funciona só no aparelho.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# 1 = a cliente confirma o WhatsApp com código (precisa da Twilio ligada no Supabase).
# Vazio = entra só com o número, que fica preso ao celular dela (ver supabase/README.md).
EXPO_PUBLIC_WHATSAPP_CODE=

# Endereço da versão web publicada (ex.: https://cores-e-fios.expo.app), usado no link que a
# profissional envia às clientes em Ajustes.
EXPO_PUBLIC_WEB_URL=
