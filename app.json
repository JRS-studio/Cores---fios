{
  "expo": {
    "name": "Cores & Fios",
    "slug": "cores-e-fios",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.coresefios.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2B1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.coresefios.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita o acesso às fotos para testar esmaltes na sua mão.",
          "cameraPermission": "Permita o acesso à câmera para fotografar sua mão e testar esmaltes."
        }
      ]
    ],
    "scheme": "coresefios",
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "backgroundColor": "#2B1220",
      "resizeMode": "contain"
    }
  }
}
