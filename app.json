{
  "expo": {
    "name": "Cores & Fios",
    "slug": "cores-e-fios",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.coresefios.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2B1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.coresefios.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Cores & Fios",
      "lang": "pt-BR",
      "themeColor": "#2B1220",
      "description": "Agende seu horário, teste cores de esmalte e acompanhe seu cartão fidelidade."
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita o acesso às fotos para testar esmaltes na sua mão e enviar a foto das unhas na avaliação.",
          "cameraPermission": "Permita o acesso à câmera para fotografar sua mão no provador e as unhas prontas na avaliação."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#2B1220"
        }
      ]
    ],
    "scheme": "coresefios",
    "experiments": {
      "typedRoutes": true
    },
    "description": "App para manicures: agenda, financeiro, clientes com fidelidade, avaliações e Provador Virtual de esmaltes."
  }
}
