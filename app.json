{
  "expo": {
    "name": "Cores & Fios",
    "slug": "cores-e-fios",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.coresefios.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2B1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.coresefios.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Cores & Fios",
      "lang": "pt-BR",
      "themeColor": "#2B1220",
      "description": "Agende seu horário, teste cores de esmalte e acompanhe seu cartão fidelidade."
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita o acesso às fotos para enviar a foto das unhas na avaliação e nas publicações do studio.",
          "cameraPermission": "Permita o acesso à câmera para fotografar as unhas prontas na avaliação e nas publicações do studio."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#2B1220"
        }
      ]
    ],
    "scheme": "coresefios",
    "experiments": {
      "typedRoutes": true
    },
    "description": "App para manicures: feed com publicações e avaliações, agenda, financeiro e clientes com fidelidade."
  }
}
